<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Override the library default; the same net9.0 SDK assemblies run on both runtimes. -->
    <TargetFramework />
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <!-- Framework runs share a physical GPU when hardware tests are enabled. -->
    <TestTfmsInParallel>false</TestTfmsInParallel>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableCudaTests)' == 'true'">
    <DefineConstants>$(DefineConstants);CUDA_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/QuantumMatter.Core/QuantumMatter.Core.csproj" />
    <ProjectReference Include="../../src/QuantumMatter.Application/QuantumMatter.Application.csproj" />
    <ProjectReference Include="../../src/QuantumMatter.Infrastructure/QuantumMatter.Infrastructure.csproj" />
    <ProjectReference Include="../../src/QuantumMatter.Demo/QuantumMatter.Demo.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="../../experiments/QuantumMatter.CryptographyLab/QuantumMatter.CryptographyLab.csproj" />
  </ItemGroup>
</Project>
